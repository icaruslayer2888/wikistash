# ==============================================================================
# WikiStash — Free Tier Environment Variables ($0/Month)
# ==============================================================================

# 1. Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Cloudflare D1 Database (Persistent SQLite with ZERO inactivity pausing)
# Run `npx wrangler d1 create wikistash-db` to create
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_uuid
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_D1_NAME=wikistash-db

# 3. Optional local flags
# Set to 'true' to simulate D1 locally via wrangler SQLite
D1_LOCAL=false
